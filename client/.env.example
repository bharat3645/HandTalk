# Copy this file to .env and adjust values for your environment.
# Create React App only exposes variables prefixed with REACT_APP_.

# Node.js signaling server (server/index.js) used by the video-call page
REACT_APP_SIGNALING_SERVER_URL=http://localhost:3001

# Python Flask server (server/server.py) used for live ASL prediction during calls
REACT_APP_PREDICTION_API_URL=http://localhost:5000

# Python Flask server (server/ser.py) used for the self-testing page
REACT_APP_SELFTEST_API_URL=http://localhost:5001

# Optional: FastAPI WebSocket backend (server/main.py) used by the experimental
# /temp video-chat page
REACT_APP_FASTAPI_WS_URL=ws://localhost:8000
