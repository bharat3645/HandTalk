# Shared image for the three Python ML backends (server.py, ser.py, main.py).
# Which script actually runs is set per-service in docker-compose.yml via
# the `command` override, since they all share the same dependencies
# (TensorFlow/Keras, MediaPipe, OpenCV, Flask/FastAPI).
FROM python:3.11-slim

# opencv-python needs libGL/glib even in headless containers.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY asl_model.py server.py ser.py main.py labels.txt best_model.keras hand_landmarker.task ./

# Overridden per-service in docker-compose.yml (PORT must match the CMD below).
ENV PORT=5000
EXPOSE 5000

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

CMD ["python", "server.py"]
